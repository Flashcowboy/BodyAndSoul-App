rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /User_Profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow everyone to read audio files, but only authenticated users to write.
    match /audio_files/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User-specific courses and progress
    match /userCourses/{uid_courseId} {
      allow read, write: if request.auth != null && uid_courseId.matches('^' + request.auth.uid + '_.*');
      match /progress/{dateId} {
        allow read, write: if request.auth != null && uid_courseId.matches('^' + request.auth.uid + '_.*');
      }
    }

    // Background music tracks (used by player UI)
    match /background_music/{docId} {
      allow read: if true;           // public readable for player
      allow write: if request.auth != null; // restrict writes to authenticated
    }

    // 14-day challenge progress per user
    match /userChallenges/{uid_challengeId} {
      allow read, write: if request.auth != null && uid_challengeId.matches('^' + request.auth.uid + '_.*');
    }
  }
}